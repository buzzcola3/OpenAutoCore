{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug openautocore",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bazel-bin/openautocore",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/runnec-gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "bazel-build-openautocore",
      "externalConsole": false
    },
    {
      "name": "Remote Debug (DebugLantern Pi)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bazel-bin/openautocore",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb-multiarch",
      "preLaunchTask": "deploy-to-debuglantern",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Connect to DebugLantern gdbserver",
          "text": "-interpreter-exec console \"source ${workspaceFolder}/.vscode/connect.gdb\"",
          "ignoreFailures": false
        }
      ]
    }
  ]
}
