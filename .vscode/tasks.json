{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-autoapp",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "-j"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "bazel-build-openautocore",
      "type": "shell",
      "command": "bazel",
      "args": [
        "build",
        "-c",
        "dbg",
        "//:openautocore"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "deploy-to-debuglantern",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/deploy-debug.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "run-openautocore",
      "type": "shell",
      "command": "./bazel-bin/openautocore",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "bazel-build-openautocore",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
