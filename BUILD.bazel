load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

exports_files([
    "configuration/ServiceDiscoveryResponse.default.json",
    "configuration/ServiceDiscoveryResponse.textproto",
])

filegroup(
    name = "autoapp",
    srcs = ["bin/autoapp"],
    visibility = ["//visibility:public"],
)

# ── DeviceManager ──
# Unified USB/WiFi device discovery and transport creation.

cc_library(
    name = "devicemanager_lib",
    srcs = glob(["src/DeviceManager/**/*.cpp"]),
    hdrs = glob(["include/DeviceManager/**/*.hpp"]),
    includes = ["include"],
    copts = [
        "-Wall",
        "-pedantic",
        "-fPIC",
    ],
    deps = [
        "@libusb//:libusb",
        "@libell_src//:ell",
        "@nlohmann_json//:json",
    ],
    alwayslink = True,
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "libdevicemanager.so",
    linkshared = True,
    deps = [":devicemanager_lib"],
    visibility = ["//visibility:public"],
)

# ── OpenAutoCore ──

cc_library(
    name = "openautocore_lib",
    srcs = glob([
        "src/**/*.cpp",
    ], exclude = [
        "bazel-*/**",
        "src/autoapp/autoapp.cpp",
        "src/autoapp.cpp",
        "src/DeviceManager/**",
    ]),
    hdrs = glob([
        "include/**/*.hpp",
    ], exclude = [
        "bazel-*/**",
        "include/DeviceManager/**",
    ]),
    includes = [
        "include",
        "include/Common",
        "include/btservice",
    ],
    copts = [
        "-include", "Common/AsioCompat.hpp",
        "-Wall",
        "-pedantic",
        "-fPIC",
    ],
    deps = [
        ":devicemanager_lib",
        "//OpenAutoSDK:aap_protobuf_cc",
        "//OpenAutoSDK:aasdk",
        "@libell_src//:ell",
        "@boost.asio//:boost.asio",
        "@boost.filesystem//:boost.filesystem",
        "@boost.log//:boost.log",
        "@boost.system//:boost.system",
        "@boost.thread//:boost.thread",
        "@libusb//:libusb",
        "@nlohmann_json//:json",
        "@openssl//:ssl",
        "@openssl//:crypto",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "openautocore",
    srcs = [
        "src/autoapp.cpp",
    ],
    includes = [
        "include",
        "include/Common",
        "include/btservice",
    ],
    copts = [
        "-include", "Common/AsioCompat.hpp",
        "-Wall",
        "-pedantic",
        "-fPIC",
    ],
    deps = [
        ":openautocore_lib",
    ],
    visibility = ["//visibility:public"],
)

